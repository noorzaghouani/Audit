name: '{{ inventory_hostname }}'
data-dir: /var/lib/etcd/{{ inventory_hostname }}.etcd
listen-peer-urls: 'http://{{ data_ip }}:2380'
listen-client-urls: 'http://{{ data_ip }}:2379,http://127.0.0.1:2379'
initial-advertise-peer-urls: 'http://{{ data_ip }}:2380'
advertise-client-urls: 'http://{{ data_ip }}:2379'
initial-cluster-token: 'etcd-cluster-odoo-ha'
initial-cluster-state: 'new'
initial-cluster: "{% for host in groups['database'] %}{{ host }}=http://{{ hostvars[host].data_ip }}:2380{% if not loop.last %},{% endif %}{% endfor %}"
